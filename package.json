  "license": "MIT",
  "keywords": ["mcp", "model-context-protocol", "jobs", "ai-jobs", "job-search", "claude"],
  "homepage": "https://jobsbylevel.com/developers",
  "repository": { "type": "git", "url": "git+https://github.com/finalburner/level-jobs-mcp.git" },
  "bugs": { "url": "https://github.com/finalburner/level-jobs-mcp/issues" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  }
}
